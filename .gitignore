
# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log

# Terraform variable files (may contain sensitive information)
*.tfvars
*.tfvars.json
!*.example.tfvars

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file backup
.terraform.lock.hcl.bak

# OS files
.DS_Store
Thumbs.db
